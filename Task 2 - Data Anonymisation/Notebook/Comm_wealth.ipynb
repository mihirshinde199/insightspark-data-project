import pandas as pd

df = pd.read_csv("mobile_customers.csv")

# Remove PII
df.drop(columns=["customer_id", "current_location", "address"], inplace=True)

# Masking
df["username"] = df["username"].apply(lambda x: "user_" + str(hash(x))[-4:])
